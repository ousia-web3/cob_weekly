{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Co-Brand Weekly Traffic Dashboard Data Schema",
  "description": "Schema for the weekly traffic data extracted from Excel and used in the dashboard.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "year": { "type": "integer", "description": "Year (e.g., 2025)" },
        "month": { "type": "integer", "description": "Month (e.g., 12)" },
        "weekNumber": { "type": "integer", "description": "Week number (e.g., 1)" },
        "weekString": { "type": "string", "description": "Week string (e.g., '2025-12-01')" },
        "range": { "type": "string", "description": "Date range (e.g., '2025.12.01 ~ 12.07')" },
        "title": { "type": "string", "description": "Report title" }
      },
      "required": ["year", "month", "weekNumber", "range"]
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalUV": { "type": "integer" },
        "prevTotalUV": { "type": "integer" },
        "growth": { "type": "number", "description": "Percentage growth vs previous week" },
        "mobileShare": { "type": "number", "description": "Mobile share percentage" },
        "bestGrowth": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "rate": { "type": "number" }
          }
        },
        "worstDrop": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "rate": { "type": "number" }
          }
        }
      },
      "required": ["totalUV", "prevTotalUV", "growth"]
    },
    "trend": {
      "type": "array",
      "description": "Weekly trend data for the area chart",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Week label (e.g., '10월 5주')" },
          "uv": { "type": "integer" }
        },
        "required": ["name", "uv"]
      }
    },
    "device": {
      "type": "array",
      "description": "Device share data for the pie chart",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "enum": ["Mobile", "PC"] },
          "value": { "type": "number" }
        },
        "required": ["name", "value"]
      }
    },
    "categories": {
      "type": "array",
      "description": "Detailed category performance",
      "items": {
        "type": "object",
        "properties": {
          "group": { "type": "string", "description": "Category group name (e.g., '공통', '패키지')" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "current": { "type": "integer" },
                "prev": { "type": "integer" },
                "rate": { "type": "number" }
              },
              "required": ["name", "current", "prev", "rate"]
            }
          }
        },
        "required": ["group", "items"]
      }
    },
    "coBrandTop20": {
      "type": "array",
      "description": "Top 20 Co-Brand domains",
      "items": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer" },
          "name": { "type": "string" },
          "uv": { "type": "integer" },
          "type": { "type": "string", "enum": ["브랜드몰", "제휴채널"] },
          "growth": { 
            "anyOf": [
              { "type": "number" },
              { "type": "string", "enum": ["new"] }
            ]
          }
        },
        "required": ["rank", "name", "uv", "type", "growth"]
      }
    },
    "detailedTop10": {
      "type": "object",
      "description": "Additional Top 10 lists",
      "properties": {
        "brandMall": { "$ref": "#/definitions/top10List" },
        "affiliate": { "$ref": "#/definitions/top10List" },
        "officialCenter": { "$ref": "#/definitions/top10List" }
      }
    },
    "aiInsight": {
      "type": "array",
      "description": "AI generated insights (optional in raw data, added later)",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["title", "content"]
      }
    }
  },
  "definitions": {
    "top10List": {
      "type": "object",
      "properties": {
        "totalUV": { "type": "integer" },
        "growth": { "type": "number" },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": { "type": "integer" },
              "name": { "type": "string" },
              "uv": { "type": "integer" }
            },
            "required": ["rank", "name", "uv"]
          }
        }
      },
      "required": ["totalUV", "growth", "data"]
    }
  },
  "required": ["meta", "summary", "trend", "categories", "coBrandTop20"]
}
